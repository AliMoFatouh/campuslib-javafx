<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.team.campuslib.controller.BookTableController"
      spacing="20">

    <VBox styleClass="page-header">
        <Label text="Books" styleClass="page-title"/>
        <Label text="Browse the CampusLib book catalog."
               styleClass="page-subtitle"/>
    </VBox>

    <VBox styleClass="card" spacing="12">
        <HBox spacing="10">
            <ComboBox fx:id="searchTypeBox"/>
            <TextField fx:id="searchField" promptText="Search books"
                       HBox.hgrow="ALWAYS"/>
            <Button text="Search" onAction="#handleSearch"/>
            <Button text="Clear" onAction="#handleClear"/>
        </HBox>

        <HBox spacing="10">
            <Button fx:id="addButton" text="Add" onAction="#handleAdd"/>
            <Button fx:id="editButton" text="Edit" onAction="#handleEdit"/>
            <Button fx:id="deleteButton" text="Delete"
                    onAction="#handleDelete"/>
        </HBox>

        <Label fx:id="messageLabel" wrapText="true"/>

        <TableView fx:id="bookTable" prefHeight="420">
            <columns>
                <TableColumn fx:id="titleColumn" text="Title" prefWidth="260"/>
                <TableColumn fx:id="authorColumn" text="Author" prefWidth="180"/>
                <TableColumn fx:id="isbnColumn" text="ISBN" prefWidth="140"/>
                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="130"/>
                <TableColumn fx:id="totalColumn" text="Total" prefWidth="70"/>
                <TableColumn fx:id="availableColumn" text="Available" prefWidth="90"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
